# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url_here
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Service role key for admin operations (CRITICAL: Keep this secret!)
# Get this from Supabase Dashboard -> Settings -> API -> service_role key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Wasender API Configuration for WhatsApp notifications
WASENDER_API_KEY=your_wasender_api_key_here
WASENDER_BASE_URL=https://wasenderapi.com/api

# Google Site Verification for SEO
GOOGLE_SITE_VERIFICATION=your_google_site_verification_code_here

# CRON Job Security
CRON_SECRET=your_secure_random_string_for_cron_authentication